{
  "name": "Customer Service Bot with DataFence Security",
  "description": "Secure customer service chatbot with database access protected by DataFence",
  "nodes": [
    {
      "id": "chat_input",
      "type": "ChatInput",
      "position": { "x": 100, "y": 200 },
      "data": {
        "display_name": "User Question"
      }
    },
    {
      "id": "openai",
      "type": "OpenAI",
      "position": { "x": 300, "y": 200 },
      "data": {
        "display_name": "GPT-4",
        "model": "gpt-4",
        "temperature": 0.7,
        "system_message": "You are a helpful customer service agent. When users ask about their account, query the customer database and provide relevant information."
      }
    },
    {
      "id": "datafence",
      "type": "DataFenceSecurity",
      "position": { "x": 500, "y": 200 },
      "data": {
        "display_name": "Security Layer",
        "policy_file": "/path/to/policies.yaml",
        "connector_type": "postgres",
        "database_uri": "postgresql://user:pass@localhost:5432/customer_db",
        "actor_id": "agent:customer_service",
        "tenant_id": "default",
        "operation": "read",
        "resource": "customers",
        "fields": "id, name, email, account_status, phone",
        "enable_sql_firewall": "true",
        "enable_pii_detection": "true",
        "limit": "10"
      }
    },
    {
      "id": "chat_output",
      "type": "ChatOutput",
      "position": { "x": 700, "y": 200 },
      "data": {
        "display_name": "Response"
      }
    }
  ],
  "edges": [
    {
      "source": "chat_input",
      "target": "openai",
      "sourceHandle": "output",
      "targetHandle": "input"
    },
    {
      "source": "openai",
      "target": "datafence",
      "sourceHandle": "output",
      "targetHandle": "resource"
    },
    {
      "source": "datafence",
      "target": "chat_output",
      "sourceHandle": "result",
      "targetHandle": "input"
    }
  ]
}
